{
  "expo": {
    "name": "TelcoVantage PoleMaster",
    "slug": "globe-mobileapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/telco-mainlogo.png",
    "scheme": "globemobileapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.telcovantage.polemaster"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B7A5A",
        "foregroundImage": "./assets/images/telco-mainlogo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.telcovantage.polemaster"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/telco-mainlogo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B7A5A",
          "dark": {
            "backgroundColor": "#0B7A5A"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "47c51a5f-e8c3-4967-8490-b7fc5f3d8f8a"
      }
    }
  }
}
